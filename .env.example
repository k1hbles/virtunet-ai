# Canonical origin. Sitemap, robots and every canonical tag derive from this.
# Without it these fall back to https://virtu.net, which will be wrong if the
# site ships on a different domain.
NEXT_PUBLIC_SITE_URL=https://virtu.net

# Lead capture for the two tools (/tools/*). Without both of these the API
# route returns 503 and the form tells the visitor to contact you directly —
# it never pretends to have sent something.
RESEND_API_KEY=
LEAD_INBOX=sales@virtu.net

# The verified sender for your Resend domain. The default below is Resend's
# shared test sender and will not work in production.
LEAD_FROM=Virtu <noreply@virtu.net>
